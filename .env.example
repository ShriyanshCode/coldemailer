# Copy to .env and fill in. Everything works without a key (static templates + rule classifier).
OPENROUTER_API_KEY=
# Comma-separated fallback chain; only model IDs ending in :free
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-small-3.1-24b-instruct:free,google/gemma-3-27b-it:free
COLDEMAILER_DB=data/coldemailer.db
