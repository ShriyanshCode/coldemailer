# Copy to .env and fill in. Everything works without a key (static templates + rule classifier).
OPENROUTER_API_KEY=
# Comma-separated fallback chain; only model IDs ending in :free
OPENROUTER_MODELS=google/gemma-4-31b-it:free,minimax/minimax-m3.1-flash:free,google/gemma-4-26b-a4b-it:free
COLDEMAILER_DB=data/coldemailer.db
# Seed for `seed` (same seed, same contacts and history). --seed on the command line wins.
COLDEMAILER_SEED=42
